@inject IAnimalImageService AnimalImageService

<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudCard onclick="@(() => OnClick.InvokeAsync(Student))">
        <MudCardContent>
            <MudStack>
                <MudStack Row Class="full">
                    <MudAvatar Style="height:50%; width:50%; font-size:2rem;">
                        <MudImage Src="@AnimalImageService.GetImageUrl(Student.Id)"></MudImage>
                    </MudAvatar>

                    <MudSpacer />
                    <MudProgressCircular Color="Color.Success" Rounded="true" Style="height:50%;width:50%;" StrokeWidth="4" Value="@(Student.Points * 10)">
                        <ChildContent>
                            <span style="font-size:1.5rem;">@Student.Points</span>
                        </ChildContent>
                    </MudProgressCircular>
                </MudStack>
                <MudText Typo="Typo.h6">@Student.Name</MudText>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudHidden>
<MudHidden Breakpoint="Breakpoint.MdAndUp">
    <MudChip T="string" Size="Size.Large" OnClick="@(() => OnClick.InvokeAsync(Student))" class="pr-0 justify-start" Style="width:100%;">
        <AvatarContent>
            <MudAvatar>
                <MudImage Src="@AnimalImageService.GetImageUrl(Student.Id)"></MudImage>
            </MudAvatar>
        </AvatarContent>
        <ChildContent>
            <span>@Student.Name</span>
            <MudSpacer></MudSpacer>
            <MudChip T="string" Style="align-self:flex-end">
                @Student.Points
            </MudChip>
        </ChildContent>
    </MudChip>
</MudHidden>

@code {
    [Parameter] public StudentDto Student { get; set; } = default!;
    [Parameter] public EventCallback<StudentDto> OnClick { get; set; }
}
